{
    "name": "de.tu-berlin.qu.gaingrab.application",
    "displayName": "Gaingrab",
    "version": "1.0.0",
    "description": "Research tool for participant-specific calibration of headphone and recorded-speech playback gain using ITU-T P.800 loudness-preference ratings.",
    "main": "./out/main/index.js",
    "author": "Eero Kaan",
    "company": "Quality and Usability Lab | TU Berlin",
    "scripts": {
        "dev:format": "prettier --write .",
        "dev:lint": "eslint --cache --fix .",
        "dev:run": "electron-vite dev -- --no-sandbox",
        "test:renderer": "node tests/renderer/run.cjs",
        "build:linux": "electron-vite build && electron-builder --linux",
        "build:win": "electron-vite build && electron-builder --win"
    },
    "dependencies": {
        "@electron-toolkit/utils": "^4.0.0",
        "@tailwindcss/vite": "^4.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.4.2",
        "lucide-react": "^0.575.0",
        "papaparse": "^5.7.0",
        "radix-ui": "^1.4.3",
        "react-i18next": "^17.0.16",
        "shadcn": "^3.8.5",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.1.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@vitejs/plugin-react": "^5.1.1",
        "electron": "^39.2.6",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-brace-style": "^0.9.0",
        "prettier-plugin-merge": "^0.9.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "vite": "^7.2.6"
    }
}
